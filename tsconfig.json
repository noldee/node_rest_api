{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
